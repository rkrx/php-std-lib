{
	"name": "rkr/std-lib",
	"type": "library",
	"license": "MIT",
	"require": {
		"php": ">= 8.2",
		"ext-iconv": "*",
		"ext-dom": "*",
		"ext-mbstring": "*",
		"ext-libxml": "*",
		"php-defer/php-defer": "dev-main",
		"rkr/date-fns": "dev-main"
	},
	"autoload": {
		"psr-4": {
			"StdLib\\": "src/"
		}
	},
	"require-dev": {
		"phpstan/phpstan": "^1.10",
		"phpunit/phpunit": "^11.5"
	},
	"scripts": {
		"phpstan": "phpstan analyse",
		"test": "phpunit"
	}
}
